# Normalisasi line ending — mencegah churn跨跨 platform Windows/Linux/macOS.
#LF di repo, CRLF saat checkout di Windows.
* text=auto eol=lf

# Binary — jangan pernah dinormalisasi.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
*.7z binary

# Script PowerShell & batch tetap CRLF (dibutuhkan Windows).
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Dokumen & source.
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Tanpa perbedaan nama berkas (Windows case-insensitive).
* text=auto
